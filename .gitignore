test-results/

# Local source/tooling archives. These are snapshots of the repository itself,
# not inputs to npm ci or the build, and tools.zip alone is 91 MB.
/*.zip

# Local browser binaries for the visual gates. Playwright is installed from the
# lockfile in CI, so these must not be versioned.
/chrome/
/chromedriver/

# Working notes that live at the repo root during a task, not shipped source.
/AUDIT_FIX_PLAN.md
/Claude Code Prompt — Implement APEX Screener Page.md


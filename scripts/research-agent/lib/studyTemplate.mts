async function main(): Promise<void> {
  const evaluateSealed = process.argv.includes('--evaluate-sealed');
  if (evaluateSealed) {
    console.error(
      '[${id}] --evaluate-sealed was passed. This should only ever happen via ' +
      'scripts/research-agent/openHoldout.mts, after the human confirmation gate. ' +
      'Proceeding because this scaffold does not re-implement that gate itself — ' +
      'the gate lives in openHoldout.mts, not in individual study files.',
    );
  }
  const result = await runStudy(evaluateSealed);
  // Print the result as the LAST thing this script writes to stdout, as
  // trailing JSON — scripts/research-agent/runQueuedStudies.mts and
  // summarizeRuns.mts both look for exactly this pattern.
  console.log(JSON.stringify(result, null, 2));
  process.exit(result.passedGate ? 0 : 0); // exit 0 either way: a clean run that failed the gate is not a crash
}

main().catch((err) => {
  console.error('[${id}] study failed:', err);
  process.exit(1);
});
`;
}

  //   2. compute the signal / positions from data
  //   3. run the backtest / walk-forward harness this project already has
  //   4. compute net, pf (profit factor), maxDD, trades, and optionally sharpe
  //   5. return { id: '${id}', evaluatedSealed, net, pf, maxDD, trades, sharpe, passedGate: evaluateGate({...}) }
  throw new Error(

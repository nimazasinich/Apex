# Optional local proxy for networks where Binance is DNS-blocked or returns
# a geographic restriction. The proxy must already be running and its use must
# comply with the provider's terms and applicable local rules.
# APEX automatically probes SOCKS5 on 127.0.0.1:10808 when no proxy
# variables are provided. Override the scheme/port or disable that behavior:
# APEX_AUTO_LOCAL_PROXY=true
# APEX_AUTO_LOCAL_PROXY_PORT=10808
# APEX_AUTO_LOCAL_PROXY_SCHEME=socks5  # socks5 | http | both
# APEX_AUTO_LOCAL_PROXY=false
# PROXY_POOL_URLS=http://127.0.0.1:10808
# SOCKS5_PROXY=127.0.0.1:10808
# PROXY_MODE=proxy_first
# MARKET_BULK_TIMEOUT_MS=8000
# MARKET_CANDLE_TIMEOUT_MS=9000

# Local APEX endpoint. `npm run dev` can replace a stale APEX process already
# listening on this port, but refuses to terminate an unrelated application.
HOST=127.0.0.1
PORT=3000
# APEX_FORCE_PORT_TAKEOVER=false

# Optional origin overrides for the two owner-managed Hugging Face fallback gateways.
# Active hierarchy: Binance Futures + KuCoin Futures public APIs → Space-2/Space-4
# → operator-entered API keys in APEX Settings. CoinMarketCap is Settings-only.
HF_SPACE_2_ORIGIN=https://really-amin-datasourceforcryptocurrency-2.hf.space
HF_SPACE_4_ORIGIN=https://really-amin-datasourceforcryptocurrency-4.hf.space

# Demo account: virtual balances and fills, while public market prices remain real.
APEX_DEMO_STARTING_BALANCE_USD=100000
APEX_DEMO_MAX_ORDER_NOTIONAL_USD=100000
APEX_DEMO_SESSION_TTL_MS=2592000000

# Verified live-account sessions are held only in server memory. These limits
# are server ceilings; a browser request cannot raise them.
APEX_EXCHANGE_SESSION_TTL_MS=28800000
APEX_LIVE_MAX_ORDER_NOTIONAL_USD=25000

# --- Security / CORS / mutation guard (src/services/serverSecurity.ts) ---
# Comma-separated extra origins allowed to call mutating endpoints, on top of
# the loopback defaults (http://127.0.0.1:<PORT>, http://localhost:<PORT>).
# APEX_CORS_ORIGINS=
# If set, POST/PUT/PATCH/DELETE requests to /api/* must send this value in the
# X-APEX-Operator-Token header. This authenticates REMOTE / non-browser callers
# (scripts, curl, a reverse proxy). You normally do NOT need it for desktop use:
# the local browser UI is trusted automatically when it is same-origin, on
# loopback, and sends the CSRF header, so setting a token here does NOT break
# the local UI. Never place this value in the frontend bundle or window.* — it
# is a server-side secret. Leave unset for a plain single-machine install.
# APEX_OPERATOR_TOKEN=
# Deployment profile: local (default) | lan | production.
# 'local' preserves the historical desktop behavior above (operator token
# optional, loopback/origin checks only). 'production' hard-requires BOTH
# APEX_OPERATOR_TOKEN to be set AND the inbound request to arrive over TLS
# (directly or via a trusted X-Forwarded-Proto: https) — mutating requests
# fail closed (503/403) otherwise. Set this to 'production' for any
# non-desktop / remote-reachable deployment.
# APEX_DEPLOYMENT_PROFILE=local
# Requests to /api/* from these hosts bypass the outbound-URL SSRF blocklist
# (private/loopback/link-local IP ranges) — comma-separated hostnames.
# APEX_SSRF_ALLOWLIST=
# Mutation rate limit: max requests per (IP, path) within the window below.
# APEX_MUTATION_RATE_LIMIT=60
# APEX_MUTATION_RATE_WINDOW_MS=60000
# Max JSON request body size accepted by express.json().
# APEX_JSON_BODY_LIMIT=1mb

# --- Server / dev runtime ---
# NODE_ENV=development
# Serve the prebuilt dist/ folder instead of Vite dev middleware.
# APEX_SERVE_DIST=false
# Mount Vite's dev middleware (disable for a pure API-only run).
# APEX_VITE_MIDDLEWARE=true
# Enable/disable hot-module-reload in dev.
# APEX_ENABLE_HMR=true
# DISABLE_HMR=false
# Standalone Vite only: proxy /api to the running APEX backend.
# APEX_API_ORIGIN=http://127.0.0.1:3000
# Allow npm run dev to replace a stale APEX process already bound to PORT.
# APEX_FORCE_PORT_TAKEOVER=false

# --- Decision memory (src/services/decisionMemory*.ts) ---
# Mirror decision-memory writes to a local file/store.
# APEX_DECISION_MEMORY_MIRROR=true
# APEX_DECISION_MEMORY_PATH=
# Optional Hugging Face dataset repo used to back up/restore decision memory.
# HF_DECISION_MEMORY_REPO=
# HF_DECISION_MEMORY_SYNC_INTERVAL_MS=
# HF_TOKEN=

# --- Testnet / validation execution store (src/services/testnetExecution.ts) ---
# APEX_TESTNET_ORDER_STORE_PATH=
# APEX_VALIDATION_RECORD_STORE_PATH=

# --- Backtesting ---
# BACKTEST_DATASOURCE_TIMEOUT_MS=

# --- Exchange clients (src/services/exchangeClient.ts) ---
# Override the default KuCoin/Binance Futures API base URLs (rarely needed).
# KUCOIN_FUTURES_BASE=
# KUCOIN_UTA_BASE=
# BINANCE_FUTURES_BASE=
# Optional dedicated proxy base URL just for Binance requests.
# BINANCE_PROXY_BASE_URL=
# EXCHANGE_REQUEST_TIMEOUT_MS=
# EXCHANGE_ROUTE_COOLDOWN_MS=
# BINANCE_EXCHANGE_INFO_TIMEOUT_MS=
# BINANCE_SENTIMENT_TIMEOUT_MS=
# BINANCE_SYMBOL_FAILURE_TTL_MS=
# DIRECT_TIMEOUT_MS=

# --- Response cache TTLs (src/services/providerRouter.ts / marketDataService.ts) ---
# CACHE_TTL_DEFAULT_MS=
# CACHE_TTL_DEPTH_MS=
# CACHE_TTL_KLINES_MS=
# CACHE_TTL_PREMIUM_MS=
# CACHE_TTL_TICKER_MS=
# Maximum age for serving the last verified candle snapshot during a transient provider outage.
# APEX_MAX_STALE_CANDLE_AGE_MS=900000
# SUPPLEMENTAL_PROVIDER_TIMEOUT_MS=

# --- Outbound proxy (src/services/proxyFetch.ts) — for networks where an
# exchange or data provider is DNS-blocked or geo-restricted. Using a proxy
# must comply with the provider's terms and applicable local rules. ---
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
# SOCKS_PROXY=
# SOCKS_PROXY_URL=
# SOCKS5_PROXY=
# APEX_LOCAL_PROXY=
# APEX_LOCAL_PROXY_PORT=
# LOCAL_PROXY_PORT=
# APEX_SOCKS_HTTP_FALLBACK=
# PROXY_DEBUG_LOG=false
# Adaptive governor. Background scanner work is isolated from chart/backtest traffic.
# PROXY_MAX_CONCURRENCY=6
# PROXY_RESERVED_INTERACTIVE=2
# PROXY_BACKGROUND_CONCURRENCY=4
# PROXY_MAX_QUEUE=80
# PROXY_BACKGROUND_MAX_QUEUE=12
# PROXY_QUEUE_TIMEOUT_CRITICAL_MS=8000
# PROXY_QUEUE_TIMEOUT_INTERACTIVE_MS=5000
# PROXY_QUEUE_TIMEOUT_BACKGROUND_MS=1250
# CACHE_STALE_GRACE_MS=45000
# UPSTREAM_CIRCUIT_FAILURE_THRESHOLD=3
# UPSTREAM_CIRCUIT_BASE_MS=20000
# UPSTREAM_CIRCUIT_MAX_MS=120000
# Legacy PROXY_QUEUE_TIMEOUT_MS is intentionally ignored by the priority governor.

# --- Third-party data source API keys (only needed if the corresponding
# supplemental provider is enabled in-app) ---
# HUGGING_FACE_TOKEN=
# ETHERSCAN_KEY=
# BSCSCAN_KEY=
# TRONSCAN_KEY=
# NEWSAPI_KEY=

# --- Telegram alert delivery ---
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=


# --- Canonical risk and execution governance ---
# Durable live execution intents (written before exchange submission).
# APEX_LIVE_EXECUTION_STORE_PATH=.apex-data/live-execution-intents.json
# Central Risk Governor limits.
# APEX_RISK_MAX_PER_TRADE_PCT=1
# APEX_RISK_MAX_TOTAL_OPEN_PCT=5
# APEX_RISK_DAILY_LOSS_LIMIT_PCT=3
# APEX_RISK_WEEKLY_LOSS_LIMIT_PCT=7
# APEX_RISK_MAX_DRAWDOWN_PCT=12
# APEX_RISK_MIN_MARGIN_RESERVE_PCT=20
# APEX_RISK_MAX_SYMBOL_EXPOSURE_PCT=25
# APEX_RISK_MAX_CORRELATED_EXPOSURE_PCT=40
# APEX_RISK_MAX_POSITIONS=6
# APEX_RISK_MAX_LEVERAGE=10
# APEX_RISK_MAX_CONSECUTIVE_LOSSES=4
# APEX_RISK_MAX_MARKET_DATA_AGE_MS=15000
# APEX_RISK_MAX_ACCOUNT_DATA_AGE_MS=20000
# APEX_RISK_AUTOMATION_FAIL_CLOSED=true
# Kill switches: booleans or comma-separated identifiers.
# APEX_KILL_ALL_TRADING=false
# APEX_KILL_NEW_ENTRIES=false
# APEX_KILL_AUTOMATED_EXECUTION=false
# APEX_KILL_EXCHANGES=
# APEX_KILL_SYMBOLS=
# APEX_KILL_STRATEGIES=

# --- Adaptive-threshold governance ---
# Proposals are never auto-promoted. Authenticated operator approval is required.
# APEX_ADAPTIVE_GOVERNANCE_PATH=.apex-data/adaptive-threshold-governance.json
# APEX_ADAPTIVE_MIN_PROMOTION_SAMPLES=96
# APEX_ADAPTIVE_MIN_RESOLVED_OUTCOMES=48
# APEX_ADAPTIVE_MIN_ADJUSTMENT_CONFIDENCE=0.72
# APEX_ADAPTIVE_MAX_RELATIVE_FIELD_CHANGE=0.20
# APEX_ADAPTIVE_REQUIRE_GUARDRAILS=true

# --- Optional KuCoin public WebSocket shadow transport ---
# Disabled by default. REST remains the verified source and any L2 sequence gap
# fails closed until a new REST snapshot is seeded.
# APEX_KUCOIN_STREAMING_ENABLED=false
# VITE_APEX_KUCOIN_STREAMING_ENABLED=false

# --- Shadow ML governance ---
# Optional versioned shadow-model artifact read by /api/operations/ml-governance.
# APEX_SHADOW_ML_MODEL_PATH=

# --- Multi-Layer Liquidity Hunter shadow core ---
# All capabilities are disabled by default. This delivery contains the ten-edge
# evidence runtime, four-layer deterministic setup evaluation, bounded realtime
# state, worker-thread event persistence, and shadow-only Dynamic Fusion.
# Provider-dependent evidence remains NOT_CONFIGURED until a verified source is
# connected. The core cannot authorize orders or autonomously promote thresholds.
APEX_LIQUIDITY_HUNTER_ENABLED=false
APEX_LIQUIDITY_HUNTER_SHADOW_ONLY=true
APEX_REALTIME_EVENT_RECORDING_ENABLED=false
# Public Binance USDⓈ-M and KuCoin USDT-M Futures collectors are primary; Bybit linear is optional/tertiary. These are read-only
# market-data feeds and remain disabled unless the core and this master flag are on.
APEX_LIQUIDITY_HUNTER_PUBLIC_FEEDS_ENABLED=false
APEX_LIQUIDITY_HUNTER_BINANCE_WS_ENABLED=false
APEX_LIQUIDITY_HUNTER_KUCOIN_WS_ENABLED=false
APEX_LIQUIDITY_HUNTER_BYBIT_WS_ENABLED=false
# Comma-separated canonical markets, bounded to 20 symbols.
APEX_LIQUIDITY_HUNTER_SYMBOLS=BTC-USDT
APEX_REALTIME_L2_ENABLED=false
APEX_OPTIONS_GEX_ENABLED=false
# Optional credential-free Deribit public option flow. Event-time gamma is
# reconstructed from trade IV when available; current ticker gamma is only a
# fallback. It remains shadow-only and is not complete dealer inventory.
APEX_LIQUIDITY_HUNTER_DERIBIT_OPTIONS_ENABLED=false
# APEX_DERIBIT_PUBLIC_BASE_URL=https://www.deribit.com/api/v2
# APEX_DERIBIT_OPTIONS_POLL_MS=20000
# Optional Hyblock v2 predictive liquidation topology. Requires a server-side
# API key and remains external shadow evidence; the key is never emitted/logged.
APEX_LIQUIDITY_HUNTER_HYBLOCK_LIQUIDATION_ENABLED=false
# APEX_HYBLOCK_API_KEY=
# APEX_HYBLOCK_API_BASE_URL=https://api.hyblockcapital.com/v2
# APEX_HYBLOCK_LIQUIDATION_EXCHANGE=binance_perp_stable
# APEX_HYBLOCK_LIQUIDATION_LOOKBACK=12h
# APEX_HYBLOCK_LIQUIDATION_POLL_MS=60000
APEX_WALLET_GRADING_ENABLED=false
# Optional public Hyperliquid position observer for an explicit watchlist. It is
# observation-only: raw addresses are pseudonymized before entering the event bus
# and observations remain UNRATED unless the separate long-history grader is enabled.
APEX_LIQUIDITY_HUNTER_HYPERLIQUID_WALLET_OBSERVER_ENABLED=false
# APEX_HYPERLIQUID_WALLET_WATCHLIST=0x0000000000000000000000000000000000000000
# APEX_HYPERLIQUID_WALLET_POLL_MS=60000
# APEX_HYPERLIQUID_WALLET_CONCURRENCY=4
# Optional public long-history grader. It queries bounded userFillsByTime +
# userFunding windows, applies fee/funding-adjusted realized metrics and refuses
# to grade truncated history. Default poll is deliberately slow.
APEX_LIQUIDITY_HUNTER_HYPERLIQUID_WALLET_HISTORY_GRADING_ENABLED=false
# APEX_HYPERLIQUID_WALLET_HISTORY_POLL_MS=21600000
# APEX_HYPERLIQUID_WALLET_HISTORY_LOOKBACK_DAYS=60
# APEX_HYPERLIQUID_WALLET_HISTORY_CONCURRENCY=2
# Optional bridge from APEX's existing supplemental sentiment providers into
# shadow-only SENTIMENT_EVENT observations. Unchanged provider scores are not
# duplicated, so polling cannot manufacture artificial sentiment velocity.
APEX_SENTIMENT_VELOCITY_ENABLED=false
# APEX_SENTIMENT_VELOCITY_POLL_MS=15000
# APEX_SENTIMENT_VELOCITY_CONCURRENCY=2
# Optional local historical-similarity meta evaluator. The artifact must contain
# DEVELOPMENT-only examples with a valid SHA-256 fingerprint; HOLDOUT examples are
# rejected. It remains shadow-only and cannot promote thresholds or authorize orders.
APEX_META_MODEL_ENABLED=false
# APEX_META_MODEL_ARTIFACT_PATH=.apex-data/liquidity-hunter/meta-model.json
APEX_LIQUIDITY_HUNTER_WS_ENABLED=false
# Research-only paper canary: records signal-price forward outcomes, never orders.
APEX_LIQUIDITY_HUNTER_PAPER_CANARY=false
# APEX_LIQUIDITY_HUNTER_PAPER_CANARY_STORE_PATH=.apex-data/liquidity-hunter/paper-canary.json
APEX_LIQUIDITY_HUNTER_EDGE_THRESHOLD_PATH=.apex-data/liquidity-hunter/edge-thresholds.json
# APEX_LIQUIDITY_HUNTER_PAPER_CANARY_HORIZON_MS=3600000
# APEX_LIQUIDITY_HUNTER_PAPER_CANARY_MAX_RECORDS=1000
# APEX_LIQUIDITY_HUNTER_SHADOW_EVALUATION_INTERVAL_MS=30000
# APEX_LIQUIDITY_HUNTER_SHADOW_EVALUATION_CONCURRENCY=2
APEX_LIQUIDITY_HUNTER_TESTNET_CANARY=false
# Optional local append-only log settings. Used only when event recording is enabled.
# APEX_REALTIME_EVENT_LOG_PATH=.apex-data/liquidity-hunter/events.jsonl
# APEX_LIQUIDITY_HUNTER_SETUP_LOG_PATH=.apex-data/liquidity-hunter/setup-transitions.jsonl
# APEX_REALTIME_QUEUE_MAX_PER_SOURCE=1024
# APEX_REALTIME_SERIES_MAX_PER_KEY=5000
# APEX_REALTIME_SERIES_MAX_AGE_MS=86400000
# APEX_REALTIME_EVENT_SEGMENT_BYTES=16777216
# APEX_REALTIME_EVENT_MAX_SEGMENTS=8

# CoinMarketCap credentials are intentionally not read from .env.
# Enter/probe them in APEX Settings; they are used only after public exchanges and both HF Spaces fail.
# Development-only Trading visual QA fixture.
# Production builds ignore this flag because the source also requires import.meta.env.DEV.
# Keep false/unset for normal development; opt in only for labeled LAB PREVIEW captures.
# VITE_APEX_TRADING_LAB_PREVIEW=false
